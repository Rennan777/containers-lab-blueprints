# Exemplo de catalog para os stacks hive-metastore/ e minio/ deste repo.
# Para ativar: renomeie para "hive.properties" e conecte este stack
# as redes do hive-metastore e do minio (ver README: "Conectando a
# outros stacks").
connector.name=hive
hive.metastore.uri=thrift://hive-metastore01:9083
hive.s3.path-style-access=true
hive.s3.endpoint=http://minio01:9000
hive.s3.aws-access-key=minio
hive.s3.aws-secret-key=minio123
hive.non-managed-table-writes-enabled=true
