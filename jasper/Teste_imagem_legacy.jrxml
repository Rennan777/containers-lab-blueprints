<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
  name="Teste_imagem"
  language="java"
  pageWidth="792"
  pageHeight="612"
  orientation="Landscape"
  columnWidth="752"
  leftMargin="20"
  rightMargin="20"
  topMargin="20"
  bottomMargin="20">
  <property name="com.jaspersoft.studio.data.defaultdataadapter" value="Sample DB"/>

  <parameter name="PARAM_IMAGEM_ID" class="java.lang.Integer"/>

  <queryString language="SQL">
    <![CDATA[]]>
  </queryString>

  <field name="IMAGEM_ID" class="java.math.BigDecimal"/>
  <field name="ENDERECO" class="java.lang.String"/>

  <background>
    <band splitType="Stretch"/>
  </background>

  <title>
    <band height="79" splitType="Stretch">
      <staticText>
        <reportElement x="326" y="24" width="100" height="30"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"/>
        <text><![CDATA[TESTE IMAGEM S3]]></text>
      </staticText>
    </band>
  </title>

  <columnHeader>
    <band height="26" splitType="Stretch">
      <staticText>
        <reportElement x="20" y="1" width="100" height="25"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"/>
        <text><![CDATA[Id Imagem: ]]></text>
      </staticText>
      <textField>
        <reportElement x="120" y="1" width="100" height="25"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"/>
        <textFieldExpression><![CDATA[$F{IMAGEM_ID}]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement x="490" y="0" width="100" height="25"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"/>
        <text><![CDATA[Link fixo:]]></text>
      </staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="125" splitType="Stretch">
      <image>
        <reportElement x="490" y="0" width="220" height="125"/>
        <imageExpression><![CDATA["https://rennan-bucket777.s3.us-east-1.amazonaws.com/img_teste/wallpaper.png"]]></imageExpression>
      </image>
      <image>
        <reportElement x="20" y="0" width="220" height="125"/>
        <imageExpression><![CDATA[$F{ENDERECO}]]></imageExpression>
      </image>
    </band>
  </detail>

  <pageFooter>
    <band height="54" splitType="Stretch">
      <textField pattern="M/d/yy h:mm a">
        <reportElement x="0" y="0" width="140" height="30"/>
        <textElement verticalAlignment="Middle"/>
        <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
      </textField>
    </band>
  </pageFooter>
</jasperReport>
